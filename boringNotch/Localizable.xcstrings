          "stringUnit" : {
            "state" : "translated",
            "value" : "静音与独奏"
          }
        }
      }
    },
    "The speaker button mutes one app. Open the arrow at the end of a row and press S to hear only that app." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The speaker button mutes one app. Open the arrow at the end of a row and press S to hear only that app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击扬声器按钮可将对应应用静音。点击该行右侧箭头，再点击 S，可仅播放该应用的声音。"
          }
        }
      }
    },
    "Output routing" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
