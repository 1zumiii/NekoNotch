      }
    },
    "A thin line along the bottom edge fills from the left with the charge: green while charging, red at 20% or less." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刘海底部的细线从左向右显示剩余电量。充电时为绿色，电量在 20% 及以下时为红色。"
          }
        }
