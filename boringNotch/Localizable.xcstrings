            "state" : "translated",
            "value" : "应用音量"
          }
        }
      }
    },
    "Drag an app's slider (up to 150%), or double-click it to go back to 100%. The faint colored bar inside the slider is the app's live level." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag an app's slider (up to 150%), or double-click it to go back to 100%. The faint colored bar inside the slider is the app's live level."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动滑块可调节应用音量（最高 150%），双击可恢复到 100%。滑块内的浅色条显示实时电平。"
          }
        }
      }
    },
    "Mute and solo" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mute and solo"
          }
        },
