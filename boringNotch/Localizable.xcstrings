    },
    "Highlight time-sensitive notifications" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "突出显示时间敏感通知"
          }
        }
      }
    },
    "They get a rainbow outline, stay twice as long, and are not pushed off by ordinary ones. The importance comes from the database, so it needs the database reader." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "时间敏感通知会显示彩虹描边，停留时间翻倍，普通通知会等待其收起后再显示。通知级别来自数据库，需开启数据库读取。"
          }
        }
      }
    },
