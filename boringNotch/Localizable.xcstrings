          }
        }
      }
    },
    "If notifications stop showing up in the notch, check which line is red or orange here." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若刘海中未显示通知，请检查此处标为红色或橙色的服务。"
