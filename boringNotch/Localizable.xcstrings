        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其中 %@ 为已删除会话的估算用量，依据 Claude Code 的统计记录计算。"
          }
        }
      }
    },
    "Local transcripts only; includes cache tokens. Claude chats without token records are excluded. Days use UTC." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基于本地会话记录统计，包含缓存 Token。已删除的 Claude 会话可根据统计记录估算补回；无 Token 明细或统计记录的聊天不计入。日期按 UTC 划分。"
          }
        }
      }
    },
