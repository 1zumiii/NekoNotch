    "Recent senders" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近发过通知的应用"
          }
        }
      }
    },
    "Exclude" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "排除"
          }
        }
      }
    },
    "Notifications from these apps are left to the system: nothing appears in the notch and their banners are not hidden. Apps without an app bundle, such as Background Items, can only be added from the recent senders." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些应用的通知仅由系统显示，刘海不显示，也不隐藏系统横幅。“后台项目”等没有独立应用的系统服务，只能从“最近发过通知的应用”中添加。"
          }
        }
      }
    },
    "Total tokens" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
